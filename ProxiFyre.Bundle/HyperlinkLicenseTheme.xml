<Theme xmlns="http://wixtoolset.org/schemas/v4/thmutil">
    <Font Id="0" Height="-12" Weight="500" Foreground="windowtext" Background="window">Segoe UI</Font>
    <Font Id="1" Height="-24" Weight="500" Foreground="windowtext">Segoe UI</Font>
    <Font Id="2" Height="-22" Weight="500" Foreground="graytext">Segoe UI</Font>
    <Font Id="3" Height="-12" Weight="500" Foreground="windowtext" Background="window">Segoe UI</Font>

    <Window Width="485" Height="300" HexStyle="100a0000" FontId="0" Caption="ProxiFyre 安装程序" IconFile="ProxiFyre.ico">
        <ImageControl X="11" Y="11" Width="64" Height="64" ImageFile="logo.png" Visible="yes"/>
        <Label X="80" Y="11" Width="-11" Height="64" FontId="1" Visible="yes" DisablePrefix="yes">ProxiFyre</Label>

        <Page Name="Help">
            <Label X="11" Y="80" Width="-11" Height="30" FontId="2" DisablePrefix="yes">帮助</Label>
            <Label X="11" Y="112" Width="-11" Height="-35" FontId="3" DisablePrefix="yes">使用以下选项安装、修复或卸载 ProxiFyre。</Label>
            <Button Name="HelpCloseButton" X="-11" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0">
                <Text>关闭</Text>
                <CloseWindowAction />
            </Button>
        </Page>
        <Page Name="Loading">
            <Label X="11" Y="80" Width="-11" Height="30" FontId="2" DisablePrefix="yes" Visible="no" Name="CheckingForUpdatesLabel" />
        </Page>
        <Page Name="Install">
            <Hypertext Name="EulaHyperlink" X="11" Y="121" Width="-11" Height="51" TabStop="yes" FontId="3" HideWhenDisabled="yes">安装即表示您同意许可条款。</Hypertext>
            <Checkbox Name="EulaAcceptCheckbox" X="-11" Y="-41" Width="260" Height="17" TabStop="yes" FontId="3" HideWhenDisabled="yes">我同意许可条款和条件</Checkbox>
            <Button Name="InstallUpdateButton" X="11" Y="-11" Width="200" Height="23" TabStop="yes" FontId="0" EnableCondition="WixStdBAUpdateAvailable" HideWhenDisabled="yes">更新</Button>
            <Button Name="OptionsButton" X="-171" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0" VisibleCondition="NOT WixStdBASuppressOptionsUI">
                <Text>选项</Text>
                <ChangePageAction Page="Options" />
            </Button>
            <Button Name="InstallButton" X="-91" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0">安装</Button>
            <Button Name="InstallCancelButton" X="-11" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0">
                <Text>取消</Text>
                <CloseWindowAction />
            </Button>
        </Page>
        <Page Name="Options">
            <Label X="11" Y="80" Width="-11" Height="30" FontId="2" DisablePrefix="yes">安装选项</Label>
            <Label X="11" Y="121" Width="-11" Height="17" FontId="3" DisablePrefix="yes">安装位置：</Label>
            <Editbox Name="InstallFolder" X="11" Y="143" Width="-91" Height="21" TabStop="yes" FontId="3" FileSystemAutoComplete="yes" />
            <Button Name="BrowseButton" X="-11" Y="142" Width="75" Height="23" TabStop="yes" FontId="3">
                <Text>浏览...</Text>
                <BrowseDirectoryAction VariableName="InstallFolder" />
            </Button>
            <Button Name="OptionsOkButton" X="-91" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0">
                <Text>确定</Text>
                <ChangePageAction Page="Install" />
            </Button>
            <Button Name="OptionsCancelButton" X="-11" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0">
                <Text>取消</Text>
                <ChangePageAction Page="Install" Cancel="yes" />
            </Button>
        </Page>
        <Page Name="Progress">
            <Label X="11" Y="80" Width="-11" Height="30" FontId="2" DisablePrefix="yes">正在安装</Label>
            <Label X="11" Y="121" Width="70" Height="17" FontId="3" DisablePrefix="yes">正在安装：</Label>
            <Label Name="OverallProgressPackageText" X="85" Y="121" Width="-11" Height="17" FontId="3" DisablePrefix="yes">总体进度</Label>
            <Progressbar Name="OverallCalculatedProgressbar" X="11" Y="143" Width="-11" Height="15" />
            <Button Name="ProgressCancelButton" X="-11" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0">取消</Button>
        </Page>
        <Page Name="Modify">
            <Label X="11" Y="80" Width="-11" Height="30" FontId="2" DisablePrefix="yes">修改 ProxiFyre</Label>
            <Button Name="ModifyUpdateButton" X="11" Y="-11" Width="200" Height="23" TabStop="yes" FontId="0" EnableCondition="WixStdBAUpdateAvailable" HideWhenDisabled="yes">更新</Button>
            <Button Name="RepairButton" X="-171" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0" HideWhenDisabled="yes">修复</Button>
            <Button Name="UninstallButton" X="-91" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0">卸载</Button>
            <Button Name="ModifyCancelButton" X="-11" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0">
                <Text>取消</Text>
                <CloseWindowAction />
            </Button>
        </Page>
        <Page Name="Success">
            <Label X="11" Y="80" Width="-11" Height="30" FontId="2" DisablePrefix="yes">
                <Text>已成功完成</Text>
                <Text Condition="WixBundleAction = 2">已成功完成</Text>
                <Text Condition="WixBundleAction = 3">已成功完成卸载</Text>
                <Text Condition="WixBundleAction = 4">已成功卸载</Text>
                <Text Condition="WixBundleAction = 5">已成功完成</Text>
                <Text Condition="WixBundleAction = 6">已成功安装</Text>
                <Text Condition="WixBundleAction = 7">已成功修改</Text>
                <Text Condition="WixBundleAction = 8">已成功修复</Text>
            </Label>
            <Button Name="LaunchButton" X="-91" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0" HideWhenDisabled="yes">启动</Button>
            <Label X="-11" Y="-51" Width="400" Height="34" FontId="3" DisablePrefix="yes" VisibleCondition="WixStdBARestartRequired">
                <Text>需要重启计算机才能完成。</Text>
                <Text Condition="WixBundleAction = 3">需要重启计算机才能完成卸载。</Text>
            </Label>
            <Button Name="SuccessRestartButton" X="-91" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0" HideWhenDisabled="yes">重启</Button>
            <Button Name="SuccessCloseButton" X="-11" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0">
                <Text>关闭</Text>
                <CloseWindowAction />
            </Button>
        </Page>
        <Page Name="Failure">
            <Label X="11" Y="80" Width="-11" Height="30" FontId="2" DisablePrefix="yes">
                <Text>安装失败</Text>
                <Text Condition="WixBundleAction = 2">安装失败</Text>
                <Text Condition="WixBundleAction = 3">卸载失败</Text>
                <Text Condition="WixBundleAction = 4">卸载失败</Text>
                <Text Condition="WixBundleAction = 5">安装失败</Text>
                <Text Condition="WixBundleAction = 6">安装失败</Text>
                <Text Condition="WixBundleAction = 7">修改失败</Text>
                <Text Condition="WixBundleAction = 8">修复失败</Text>
            </Label>
            <Hypertext Name="FailureLogFileLink" X="11" Y="121" Width="-11" Height="42" FontId="3" TabStop="yes" HideWhenDisabled="yes">查看日志文件以了解详细信息。</Hypertext>
            <Hypertext Name="FailureMessageText" X="22" Y="163" Width="-11" Height="51" FontId="3" TabStop="yes" HideWhenDisabled="yes" />
            <Label X="-11" Y="-51" Width="400" Height="34" FontId="3" DisablePrefix="yes" VisibleCondition="WixStdBARestartRequired">需要重启计算机才能完成。</Label>
            <Button Name="FailureRestartButton" X="-91" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0" HideWhenDisabled="yes">重启</Button>
            <Button Name="FailureCloseButton" X="-11" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0">
                <Text>关闭</Text>
                <CloseWindowAction />
            </Button>
        </Page>
    </Window>
</Theme>
